.PROGRAM measure()

;--------------------------------------------------------
; 【4】マスター基準距離との差分計算
;     「今どれだけズレているか」を数値化
;     実際はロボ1はロボ3からずれ量のみを受け取る
;--------------------------------------------------------

diff_fl = d_fl - d_fl_ref
diff_fr = d_fr - d_fr_ref
diff_sf = d_sf - d_sf_ref
diff_sb = d_sb - d_sb_ref


;--------------------------------------------------------
; 【5】回転角Oの算出（正面2点のみ使用）
;
; 考え方：
;   同一面2点の距離差 → 面の傾き → 回転角
;--------------------------------------------------------


delta_o = ATAN2( (diff_fr - diff_fl), w_front )

; 異常値抑制（大回転は機械的にNG）
;delta_o = CLAMP(delta_o, -max_o, max_o)


;--------------------------------------------------------
; 【6】正面センサーの回転影響を除去
;
; 距離には
;   ・並進成分
;   ・回転による見かけ成分
; が混ざっているため、回転分を引く
;--------------------------------------------------------
rot_fl = -1 * (w_front / 2) * (w_front/(diff_fr - diff_fl))
rot_fr =  (w_front / 2) * (w_front/(diff_fr - diff_fl))

trans_fl = diff_fl - rot_fl
trans_fr = diff_fr - rot_fr

;--------------------------------------------------------
; 【7】正面「面」としてのY方向並進量
;
; ※ ここでの平均(÷2)は
;    「面の基準線の並進」を意味する
;--------------------------------------------------------

y_face = - (trans_fl + trans_fr) / 2



;--------------------------------------------------------
; 【8】側面センサーの回転影響を除去
;
; 正面で求めた回転Oは剛体共通なので
; 側面にも同じ回転影響が乗る
;--------------------------------------------------------


rot_sf = (w_side / 2) * (w_front/(diff_fr - diff_fl))
rot_sb = -1 * (w_side / 2) * (w_front/(diff_fr - diff_fl))

trans_sf = diff_sf - rot_sf
trans_sb = diff_sb - rot_sb


;--------------------------------------------------------
; 【9】側面「面」としてのX方向並進量
;--------------------------------------------------------

x_face = - (trans_sf + trans_sb) / 2


;--------------------------------------------------------
; 【10】マスター基準点（中央でない）への補正
;
; 面中心の並進(x_face, y_face)に
; 回転によって生じる基準点の移動量を加える
;--------------------------------------------------------

; 回転による基準点の見かけ移動（小角近似）
y_rot =  master_offset_x * SIN(delta_o)
x_rot = -master_offset_y * SIN(delta_o)

; マスター基準点での真の補正量
delta_y = y_face + y_rot
delta_x = x_face + x_rot


;--------------------------------------------------------
; 【11】最終補正量の安全制限
;--------------------------------------------------------

;delta_x = CLAMP(delta_x, -max_x, max_x)
;delta_y = CLAMP(delta_y, -max_y, max_y)



;--------------------------------------------------------
; 【12】補正後の置き位置を生成
;--------------------------------------------------------

target_x = master_x + delta_x
target_y = master_y + delta_y
target_z = master_z
target_o = master_o + delta_o
target_a = master_a
target_t = master_t

POINT target_corrected = target_master+TRANS(delta_x, delta_y, 0, delta_o, 0, 0)


;--------------------------------------------------------
; 【13】デバッグ・ログ出力（必須）
;--------------------------------------------------------

JMOVE start_pos
BREAK

JAPPRO target_corrected,300
LMOVE target_corrected
BREAK
LDEPART 300



;====================== END ==============================

.END




.TRANS
start_pos 0 530 705 90 180 -90
.END

.REAL
;--------------------------------------------------------
; 【1】幾何・機械定数定義（図面で決まる固定値）
;--------------------------------------------------------

w_front = 200.0        ; 正面 左右センサー間距離[mm]
w_side  = 180.0        ; 側面 前後センサー間距離[mm]

; マスター置き位置（赤矢印原点）が
; 各面の幾何中心からどれだけズレているか
; ※ 回転補正に必須
master_offset_x = 50.0    ; 面中心 → +X方向[mm]
master_offset_y = -20.0    ; 面中心 → -Y方向[mm]


;--------------------------------------------------------
; 【2】測定・安全関連設定
;--------------------------------------------------------

measure_cnt = 3       ; センサー測定回数（冗長性）
max_o = 15.0           ; 回転補正上限[deg]
max_x = 15.0           ; X補正上限[mm]
max_y = 15.0           ; Y補正上限[mm]


d_fl_ref = 100.0         ; マスター基準距離 正面 左[mm]
d_fr_ref = 100.0         ; マスター基準距離 正面 右[mm]
d_sf_ref = 100.0         ; マスター基準距離 側面 前[mm]
d_sb_ref = 100.0         ; マスター基準距離 側面 後[mm]
d_fl = 0.0               ; 現在距離 正面 左[mm]
d_fr = 0.0               ; 現在距離 正面 右[mm]
d_sf = 0.0               ; 現在距離 側面 前[mm]
d_sb = 0.0               ; 現在距離 側面 後[mm]

.END