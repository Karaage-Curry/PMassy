.PROGRAM measure()

;========================================================
; 置き位置補正PG（正面2点＋側面2点方式）
;
; 目的：
;   距離センサー（正面2点・側面2点）から
;   置台の  X並進 / Y並進 / Z軸回転(O)  を算出し、
;   マスター置き位置 (X,Y,Z,O,A,T) を補正する
;
; 特徴：
;   ・回転は同一面2点から幾何的に算出
;   ・回転と並進を分離して計算
;   ・マスター基準点が中央でなくても成立
;   ・外れ値に強い（複数回測定＋中央値）
;========================================================


;--------------------------------------------------------
; 【1】幾何・機械定数定義（図面で決まる固定値）
;--------------------------------------------------------

W_FRONT = 200.0        ; 正面 左右センサー間距離[mm]
W_SIDE  = 180.0        ; 側面 前後センサー間距離[mm]

; マスター置き位置（赤矢印原点）が
; 各面の幾何中心からどれだけズレているか
; ※ 回転補正に必須
MASTER_OFFSET_X = +50.0    ; 面中心 → +X方向[mm]
MASTER_OFFSET_Y = -20.0    ; 面中心 → -Y方向[mm]


;--------------------------------------------------------
; 【2】測定・安全関連設定
;--------------------------------------------------------

MEASURE_CNT = 5       ; センサー測定回数（冗長性）
MAX_O = 1.0           ; 回転補正上限[deg]
MAX_X = 5.0           ; X補正上限[mm]
MAX_Y = 5.0           ; Y補正上限[mm]


;--------------------------------------------------------
; 【3】センサー値取得（外れ値対策）
;     同じセンサーを複数回読み、中央値を使う
;--------------------------------------------------------

front_L_vals = []
front_R_vals = []
side_F_vals  = []
side_B_vals  = []

FOR i = 1 TO MEASURE_CNT
    front_L_vals.ADD( READ_FRONT_LEFT() )   ; 正面 左
    front_R_vals.ADD( READ_FRONT_RIGHT() )  ; 正面 右
    side_F_vals.ADD(  READ_SIDE_FRONT() )   ; 側面 前
    side_B_vals.ADD(  READ_SIDE_BACK() )    ; 側面 後
END FOR

; スパイク・ノイズ除去のため中央値を採用
D_FL = MEDIAN(front_L_vals)
D_FR = MEDIAN(front_R_vals)
D_SF = MEDIAN(side_F_vals)
D_SB = MEDIAN(side_B_vals)


;--------------------------------------------------------
; 【4】マスター基準距離との差分計算
;     「今どれだけズレているか」を数値化
;--------------------------------------------------------

diff_FL = D_FL - D_FL_REF
diff_FR = D_FR - D_FR_REF
diff_SF = D_SF - D_SF_REF
diff_SB = D_SB - D_SB_REF


;--------------------------------------------------------
; 【5】回転角Oの算出（正面2点のみ使用）
;
; 考え方：
;   同一面2点の距離差 → 面の傾き → 回転角
;--------------------------------------------------------

delta_O = ATAN( (diff_FR - diff_FL) / W_FRONT )

; 異常値抑制（大回転は機械的にNG）
delta_O = CLAMP(delta_O, -MAX_O, MAX_O)

;--------------------------------------------------------
; 【6】正面センサーの回転影響を除去
;
; 距離には
;   ・並進成分
;   ・回転による見かけ成分
; が混ざっているため、回転分を引く
;--------------------------------------------------------

rot_FL = - (W_FRONT / 2) * TAN(delta_O)
rot_FR = + (W_FRONT / 2) * TAN(delta_O)

trans_FL = diff_FL - rot_FL
trans_FR = diff_FR - rot_FR


;--------------------------------------------------------
; 【7】正面「面」としてのY方向並進量
;
; ※ ここでの平均(÷2)は
;    「面の基準線の並進」を意味する
;--------------------------------------------------------

Y_face = - (trans_FL + trans_FR) / 2


;--------------------------------------------------------
; 【8】側面センサーの回転影響を除去
;
; 正面で求めた回転Oは剛体共通なので
; 側面にも同じ回転影響が乗る
;--------------------------------------------------------

rot_SF = + (W_SIDE / 2) * TAN(delta_O)
rot_SB = - (W_SIDE / 2) * TAN(delta_O)

trans_SF = diff_SF - rot_SF
trans_SB = diff_SB - rot_SB


;--------------------------------------------------------
; 【9】側面「面」としてのX方向並進量
;--------------------------------------------------------

X_face = - (trans_SF + trans_SB) / 2


;--------------------------------------------------------
; 【10】マスター基準点（中央でない）への補正
;
; 面中心の並進(X_face, Y_face)に
; 回転によって生じる基準点の移動量を加える
;--------------------------------------------------------

; 回転による基準点の見かけ移動（小角近似）
Y_rot =  MASTER_OFFSET_X * SIN(delta_O)
X_rot = -MASTER_OFFSET_Y * SIN(delta_O)

; マスター基準点での真の補正量
delta_Y = Y_face + Y_rot
delta_X = X_face + X_rot


;--------------------------------------------------------
; 【11】最終補正量の安全制限
;--------------------------------------------------------

delta_X = CLAMP(delta_X, -MAX_X, MAX_X)
delta_Y = CLAMP(delta_Y, -MAX_Y, MAX_Y)


;--------------------------------------------------------
; 【12】補正後の置き位置を生成
;--------------------------------------------------------

TARGET.X = MASTER.X + delta_X
TARGET.Y = MASTER.Y + delta_Y
TARGET.Z = MASTER.Z
TARGET.O = MASTER.O + delta_O
TARGET.A = MASTER.A
TARGET.T = MASTER.T


;--------------------------------------------------------
; 【13】デバッグ・ログ出力（必須）
;--------------------------------------------------------

PRINT("FRONT L,R =", D_FL, D_FR)
PRINT("SIDE  F,B =", D_SF, D_SB)
PRINT("DIFF       =", diff_FL, diff_FR, diff_SF, diff_SB)
PRINT("ROT O      =", delta_O)
PRINT("FACE X,Y   =", X_face, Y_face)
PRINT("DELTA X,Y  =", delta_X, delta_Y)
PRINT("TARGET POS =", TARGET)

;====================== END ==============================

  
.END